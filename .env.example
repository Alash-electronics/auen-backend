# Copy this file to .env and fill in real values.

# --- Server ---
PORT=4000
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=*

# --- Database ---
# SQLite (via Node's built-in node:sqlite) is used by default so the
# project runs with zero external services and zero binary downloads.
# For production, swap src/db.ts for a Postgres pool if you need it.
DATABASE_URL="file:./dev.db"

# --- Spotify (https://developer.spotify.com/dashboard) ---
# 1. Create an app in the Spotify Developer Dashboard (free, instant).
# 2. Add a Redirect URI, e.g. auen://spotify-callback
# 3. Copy the Client ID (and Client Secret if you use the confidential flow).
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=auen://spotify-callback

# --- Apple Music / MusicKit (https://developer.apple.com/account) ---
# Requires a paid Apple Developer Program membership ($99/yr).
# 1. Create a MusicKit identifier + a MusicKit private key (.p8) in the
#    Apple Developer portal (Certificates, Identifiers & Profiles > Keys).
# 2. Fill these in once you have them. Everything below is optional until
#    you're ready to test real Apple Music integration.
APPLE_TEAM_ID=your-apple-team-id
APPLE_MUSIC_KEY_ID=your-musickit-key-id
# Paste the contents of the .p8 file, replacing newlines with \n
APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
